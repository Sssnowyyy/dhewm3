# Generates a C file embedding the compiled .gsh shaders
#   cmake -DOUT=<file.c> -DDIR=<dir with .gsh files> -DNAMES="a;b;c" -P embed.cmake

set(src "// generated by sys/wiiu/shaders/embed.cmake, do not edit\n\n#include \"sys/wiiu/gx2_shaders.h\"\n\n")
set(table "")
foreach(name ${NAMES})
	file(READ "${DIR}/${name}.gsh" hex HEX)
	string(LENGTH "${hex}" len)
	math(EXPR size "${len} / 2")
	string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
	# GFD data is read with 32bit loads, so keep it aligned
	string(APPEND src "static const unsigned char gsh_${name}[${size}] __attribute__((aligned(256))) = {\n${bytes}\n};\n\n")
	string(APPEND table "\t{ \"${name}\", gsh_${name}, ${size} },\n")
endforeach()
string(APPEND src "const gx2EmbeddedShader_t gx2EmbeddedShaders[] = {\n${table}\t{ 0, 0, 0 }\n};\n")
file(WRITE "${OUT}" "${src}")
